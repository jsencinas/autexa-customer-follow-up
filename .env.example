# ---- Core ----
APP_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/app.db
STORAGE_DIR=./data/images
MAX_UPLOAD_MB=10
# Set to false only for local development over plain http
SESSION_COOKIE_SECURE=true
LOG_LEVEL=INFO

# ---- Phone numbers / timezone ----
DEFAULT_COUNTRY_CODE=ES
BUSINESS_TIMEZONE=Europe/Madrid

# ---- WhatsApp Cloud API (Coexistence number) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ---- Ollama ----
OLLAMA_URL=http://localhost:11434
EXTRACTION_MODEL=qwen2.5vl:7b
REPLY_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120

# ---- Survey flow ----
SURVEY_DELAY_HOURS=24
CONFIRMATION_EXPIRY_HOURS=24
SURVEY_QUIET_PERIOD_MINUTES=120
FREE_TEXT_WINDOW_MINUTES=120
INTERPRETATION_WINDOW_DAYS=7
OPT_OUT_THRESHOLD=0.5
RATING_THRESHOLD=0.8

# ---- Sending hours (initial defaults; edited later in the admin section) ----
DEFAULT_SENDING_DAYS=mon,tue,wed,thu,fri,sat
DEFAULT_SENDING_START=09:00
DEFAULT_SENDING_END=18:00

# ---- Worker / retries ----
WORKER_TICK_SECONDS=5
SEND_RATE_PER_SECOND=1
MAX_SEND_ATTEMPTS=5
MAX_EXTRACTION_ATTEMPTS=3
MAX_INTERPRETATION_ATTEMPTS=5
MAX_REPORT_ATTEMPTS=5
RETRY_BASE_SECONDS=60
IMAGE_RETENTION_DAYS=90

# ---- Email (monthly report) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
DEFAULT_REPORT_DAY=1
DEFAULT_REPORT_TIME=08:00

# ---- Auth ----
EMPLOYEE_SESSION_HOURS=12
ADMIN_SESSION_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
