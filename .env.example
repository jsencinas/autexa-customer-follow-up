# WhatsApp Config
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_API_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_API_URL=https://graph.facebook.com/v19.0

# Security / Allowlist (comma separated phone numbers in E.164 format, e.g. +1234567890)
ALLOWED_EMPLOYEE_PHONES=+1234567890,+0987654321

# App Config
DATABASE_URL=sqlite:///./app.db
OLLAMA_URL=http://localhost:11434
VISION_MODEL_NAME=llama3.2-vision

# Scheduling & Business Hours
SURVEY_DELAY_HOURS=24
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
BUSINESS_DAYS=0,1,2,3,4,5  # 0=Monday, 5=Saturday (Python weekday convention)
TIMEZONE=America/Mexico_City

# Data Retention
RETENTION_DAYS=90
